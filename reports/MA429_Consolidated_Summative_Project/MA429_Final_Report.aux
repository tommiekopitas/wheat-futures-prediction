\@writefile{lof}{\contentsline {figure}{\numberline {B8}{\ignorespaces Fisher z-averaged correlation matrix of the 12 raw CY-Bench variables across 507 regions. Nine feature pairs exceed $|\rho | = 0.85$, concentrated among temperature-derived variables. This motivates the correlation-based filtering applied before modelling.}}{25}{figure.8}\protected@file@percent }
\newlabel{fig:corr_heatmap}{{B8}{25}{Fisher z-averaged correlation matrix of the 12 raw CY-Bench variables across 507 regions. Nine feature pairs exceed $|\rho | = 0.85$, concentrated among temperature-derived variables. This motivates the correlation-based filtering applied before modelling}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B9}{\ignorespaces (a) Wheat yield distributions by country (2003-2020). Germany has the highest average yield (7.35 t/ha) and the widest spread across its 251 NUTS3 regions. (b) Average wheat yield over time by country. The 2018 European drought is visible as a synchronised dip, with Germany experiencing the largest decline ($-7.3\%$ relative to other years).}}{25}{figure.9}\protected@file@percent }
\newlabel{fig:yield_dist}{{B9}{25}{(a) Wheat yield distributions by country (2003-2020). Germany has the highest average yield (7.35 t/ha) and the widest spread across its 251 NUTS3 regions. (b) Average wheat yield over time by country. The 2018 European drought is visible as a synchronised dip, with Germany experiencing the largest decline ($-7.3\%$ relative to other years)}{figure.9}{}}
