\@writefile{lof}{\contentsline {figure}{\numberline {B1}{\ignorespaces France-average 30-day cumulative precipitation (2003-2023). Precipitation fluctuates on a seasonal cycle with substantial inter-annual variability but, unlike NDVI, lacks a consistent repeating pattern, reflecting the stochastic nature of rainfall events.}}{21}{figure.1}\protected@file@percent }
\newlabel{fig:precipitation}{{B1}{21}{France-average 30-day cumulative precipitation (2003-2023). Precipitation fluctuates on a seasonal cycle with substantial inter-annual variability but, unlike NDVI, lacks a consistent repeating pattern, reflecting the stochastic nature of rainfall events}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B2}{\ignorespaces Empirical 5-day return distribution compared with fitted Normal and Student-t densities. The fitted Student-t has 3.6 degrees of freedom, confirming substantially heavier tails than the Gaussian benchmark.}}{21}{figure.2}\protected@file@percent }
\newlabel{fig:return_vs_t}{{B2}{21}{Empirical 5-day return distribution compared with fitted Normal and Student-t densities. The fitted Student-t has 3.6 degrees of freedom, confirming substantially heavier tails than the Gaussian benchmark}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B3}{\ignorespaces France-average NDVI (top) and fPAR (bottom), 2003-2023. Both indicators track each other closely ($r = 0.93$ on 30-day smoothed series) but diverge during cloud-contaminated periods due to different gap-filling methods, justifying retaining both in the feature set.}}{22}{figure.3}\protected@file@percent }
\newlabel{fig:ndvi_fpar}{{B3}{22}{France-average NDVI (top) and fPAR (bottom), 2003-2023. Both indicators track each other closely ($r = 0.93$ on 30-day smoothed series) but diverge during cloud-contaminated periods due to different gap-filling methods, justifying retaining both in the feature set}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B4}{\ignorespaces France-average surface soil moisture (blue, left axis) and root-zone soil moisture (red, right axis), 2003-2023. Surface moisture responds rapidly to individual precipitation events while root-zone moisture evolves more slowly, capturing different timescales of water availability despite near-perfect correlation ($r = 0.99$) in smoothed trends.}}{22}{figure.4}\protected@file@percent }
\newlabel{fig:soil_moisture}{{B4}{22}{France-average surface soil moisture (blue, left axis) and root-zone soil moisture (red, right axis), 2003-2023. Surface moisture responds rapidly to individual precipitation events while root-zone moisture evolves more slowly, capturing different timescales of water availability despite near-perfect correlation ($r = 0.99$) in smoothed trends}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B5}{\ignorespaces Germany-average daily temperature range with stress thresholds (top) and annual growing-season (Mar-Aug) stress day counts (bottom). The 2018 European drought produced 2.5$\times $ the average number of hot stress days (Tmax $> 30$\textdegree C), motivating the threshold-based stress indicators in Section~\ref {sec:feature_eng}.}}{23}{figure.5}\protected@file@percent }
\newlabel{fig:temp_stress_de}{{B5}{23}{Germany-average daily temperature range with stress thresholds (top) and annual growing-season (Mar-Aug) stress day counts (bottom). The 2018 European drought produced 2.5$\times $ the average number of hot stress days (Tmax $> 30$\textdegree C), motivating the threshold-based stress indicators in Section~\ref {sec:feature_eng}}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B6}{\ignorespaces France-average daily temperature range with stress thresholds (top) and annual growing-season stress day counts (bottom). France shows higher baseline hot-day frequency than Germany, with 2003 and 2022 as the most extreme heat years.}}{23}{figure.6}\protected@file@percent }
\newlabel{fig:temp_stress_fr}{{B6}{23}{France-average daily temperature range with stress thresholds (top) and annual growing-season stress day counts (bottom). France shows higher baseline hot-day frequency than Germany, with 2003 and 2022 as the most extreme heat years}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {B7}{\ignorespaces Poland-average daily temperature range with stress thresholds (top) and annual growing-season stress day counts (bottom). Poland exhibits substantially more cold stress days than France or Germany, reflecting its continental climate, while hot stress events are comparatively rare.}}{24}{figure.7}\protected@file@percent }
\newlabel{fig:temp_stress_pl}{{B7}{24}{Poland-average daily temperature range with stress thresholds (top) and annual growing-season stress day counts (bottom). Poland exhibits substantially more cold stress days than France or Germany, reflecting its continental climate, while hot stress events are comparatively rare}{figure.7}{}}
